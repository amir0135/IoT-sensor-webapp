# ---- Azure Data Explorer (Kusto) connection ----
KUSTO_CLUSTER=https://<your-cluster>.<region>.kusto.windows.net
KUSTO_DB=IoTDatabase
KUSTO_TABLE=IoTSensorData

# ---- Authentication ----
# default = DefaultAzureCredential: managed identity in Azure, `az login` locally. Recommended — no secret.
# app_key = Microsoft Entra service principal with a client secret (fill the three values below).
AUTH_MODE=default

# Only required when AUTH_MODE=app_key:
APP_ID=
APP_SECRET=
TENANT_ID=

# ---- CORS ----
# Comma-separated browser origins allowed to call the API (your frontend URL, plus localhost for dev).
ALLOWED_ORIGINS=http://localhost:3000
