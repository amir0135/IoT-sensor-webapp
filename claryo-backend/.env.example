# Azure Data Explorer (Kusto) connection
KUSTO_CLUSTER=https://<your-cluster>.<region>.kusto.windows.net
KUSTO_DB=<your-database>

# Microsoft Entra service principal used for ADX access.
# Create with: az ad sp create-for-rbac --name claryo-adx-reader
APP_ID=<entra-application-client-id>
APP_SECRET=<entra-client-secret>
TENANT_ID=<entra-tenant-id>
